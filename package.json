{
  "name": "novasvn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "npm run test:components && npm run test:scripts && npm run build && npm run test:rust",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:components": "vitest run --dir src",
    "test:svn": "powershell -ExecutionPolicy Bypass -File scripts/test-svn-workflow.ps1",
    "test:svn:partial": "powershell -ExecutionPolicy Bypass -File scripts/test-svn-partial-commit.ps1",
    "test:scripts": "node scripts/test-package-scripts.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "benchmark:svn": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/benchmark-svn-workspace.ps1",
    "benchmark:svn:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/benchmark-svn-workspace.ps1 -Reset",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "version:sync": "node scripts/sync-version.mjs",
    "version:print": "node scripts/sync-version.mjs --print",
    "version:check": "node scripts/sync-version.mjs --check",
    "release:windows": "npm run version:check && tauri build --bundles nsis",
    "release:macos": "npm run version:check && bash scripts/build-macos-finder-sync.sh && tauri build --bundles dmg && bash scripts/inject-macos-finder-sync-into-dmg.sh"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@lucide/svelte": "^1.24.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "monaco-editor": "^0.55.1",
    "svelte": "^5.56.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  }
}
